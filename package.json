{
  "name": "ckstats",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && mkdir -p -m 700 .next/server/route-cache",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "ts-node -P tsconfig.scripts.json scripts/seed.ts",
    "update-users": "ts-node -P tsconfig.scripts.json scripts/updateUsers.ts",
    "cleanup": "ts-node -P tsconfig.scripts.json scripts/cleanOldStats.ts",
    "vacuum": "dotenv -e .env -- bash -c 'PGPASSWORD=\"$DB_PASSWORD\" psql -h \"$DB_HOST\" -p \"$DB_PORT\" -U \"$DB_USER\" -d \"$DB_NAME\" -f scripts/vacuum.sql'",
    "test": "jest",
    "test:watch": "jest --watch",
    "migration:run": "ts-node -P tsconfig.scripts.json ./scripts/migration.ts",
    "migration:run:skip": "ts-node -P tsconfig.scripts.json ./scripts/migration.ts --skip-initial"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "bech32": "^2.0.0",
    "bs58check": "^4.0.0",
    "daisyui": "^5.8.1",
    "echarts": "^6.1.0",
    "next": "^16.4.6",
    "node-cache": "^5.1.2",
    "p-limit": "^3.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "postcss": "^8.5.15",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}